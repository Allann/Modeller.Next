{
  "folders": [
    {
      "name": "Modeller",
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      "**/.next": true,
      "**/.source": true
    },
    "files.watcherExclude": {
      "**/.next/**": true,
      "**/node_modules/**": true
    },
    "search.exclude": {
      "**/.next": true,
      "**/.source": true,
      "**/node_modules": true
    },
    "editor.formatOnSave": true,
    "typescript.tsdk": "node_modules/typescript/lib"
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "unifiedjs.vscode-mdx",
      "bradlc.vscode-tailwindcss"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "setup",
        "type": "process",
        "command": "npm.cmd",
        "args": ["install"],
        "options": { "cwd": "${workspaceFolder}/apps/docs" },
        "problemMatcher": []
      },
      {
        "label": "docs: dev",
        "type": "process",
        "command": "npm.cmd",
        "args": ["run", "dev"],
        "options": { "cwd": "${workspaceFolder}/apps/docs" },
        "isBackground": true,
        "problemMatcher": {
          "owner": "modeller-docs",
          "pattern": {
            "regexp": "^(.*)$",
            "message": 1
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*Starting.*",
            "endsPattern": ".*Ready in.*"
          }
        },
        "presentation": {
          "group": "development",
          "reveal": "always",
          "panel": "dedicated"
        }
      },
      {
        "label": "docs: build",
        "type": "process",
        "command": "npm.cmd",
        "args": ["run", "build"],
        "options": { "cwd": "${workspaceFolder}/apps/docs" },
        "problemMatcher": ["$tsc"]
      },
      {
        "label": "docs: lint",
        "type": "process",
        "command": "npm.cmd",
        "args": ["run", "lint"],
        "options": { "cwd": "${workspaceFolder}/apps/docs" },
        "problemMatcher": ["$eslint-stylish"]
      },
      {
        "label": "docs: types",
        "type": "process",
        "command": "npm.cmd",
        "args": ["run", "types:check"],
        "options": { "cwd": "${workspaceFolder}/apps/docs" },
        "problemMatcher": ["$tsc"]
      },
      {
        "label": "studio: dev",
        "type": "process",
        "command": "npm.cmd",
        "args": ["run", "dev"],
        "options": { "cwd": "${workspaceFolder}/apps/studio" },
        "isBackground": true,
        "problemMatcher": {
          "owner": "modeller-studio",
          "pattern": {
            "regexp": "^(.*)$",
            "message": 1
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*Starting.*",
            "endsPattern": ".*ready.*"
          }
        },
        "presentation": {
          "group": "development",
          "reveal": "always",
          "panel": "dedicated"
        }
      },
      {
        "label": "studio: build lsp",
        "type": "process",
        "command": "npm.cmd",
        "args": ["run", "server:build"],
        "options": { "cwd": "${workspaceFolder}/apps/studio" },
        "problemMatcher": "$msCompile"
      },
      {
        "label": "playground: api",
        "type": "process",
        "command": "dotnet",
        "args": ["run", "--project", "src/Modeller.Api/Modeller.Api.csproj"],
        "options": {
          "cwd": "${workspaceFolder}",
          "env": {
            "PORT": "8080",
            "ASPNETCORE_ENVIRONMENT": "Development",
            "Cors__AllowedOrigins__0": "http://localhost:3110"
          }
        },
        "isBackground": true,
        "problemMatcher": {
          "owner": "modeller-playground-api",
          "pattern": {
            "regexp": "^(.*)$",
            "message": 1
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*Building.*",
            "endsPattern": ".*Now listening on.*"
          }
        },
        "presentation": {
          "group": "development",
          "reveal": "always",
          "panel": "dedicated"
        }
      },
      {
        "label": "playground: web",
        "type": "process",
        "command": "npm.cmd",
        "args": ["run", "dev"],
        "options": {
          "cwd": "${workspaceFolder}/apps/studio",
          "env": {
            "PORT": "3110",
            "NEXT_PUBLIC_MODELLER_STUDIO_MODE": "playground",
            "NEXT_PUBLIC_MODELLER_API_URL": "http://localhost:8080",
            "MODELLER_STUDIO_DIST_DIR": ".next-playground-local"
          }
        },
        "isBackground": true,
        "problemMatcher": {
          "owner": "modeller-playground-web",
          "pattern": {
            "regexp": "^(.*)$",
            "message": 1
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*Starting.*",
            "endsPattern": ".*ready.*"
          }
        },
        "presentation": {
          "group": "development",
          "reveal": "always",
          "panel": "dedicated"
        }
      },
      {
        "label": "playground: dev",
        "dependsOrder": "parallel",
        "dependsOn": ["playground: api", "playground: web"],
        "problemMatcher": []
      },
      {
        "label": "model: test",
        "type": "process",
        "command": "dotnet",
        "args": ["test", "Modeller.slnx"],
        "problemMatcher": "$msCompile"
      },
      {
        "label": "verify",
        "dependsOrder": "sequence",
        "dependsOn": ["model: test", "docs: lint", "docs: types", "docs: build"],
        "problemMatcher": []
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Modeller Docs",
        "type": "pwa-chrome",
        "request": "launch",
        "url": "http://localhost:3000",
        "webRoot": "${workspaceFolder}/apps/docs",
        "preLaunchTask": "docs: dev"
      },
      {
        "name": "Modeller Docs: server",
        "type": "node-terminal",
        "request": "launch",
        "command": "npm run dev",
        "cwd": "${workspaceFolder}/apps/docs"
      },
      {
        "name": "Modeller Studio",
        "type": "pwa-chrome",
        "request": "launch",
        "url": "http://localhost:3100",
        "webRoot": "${workspaceFolder}/apps/studio",
        "preLaunchTask": "studio: dev"
      },
      {
        "name": "Modeller Studio: server",
        "type": "node-terminal",
        "request": "launch",
        "command": "npm run dev",
        "cwd": "${workspaceFolder}/apps/studio"
      },
      {
        "name": "Modeller Playground",
        "type": "pwa-chrome",
        "request": "launch",
        "url": "http://localhost:3110",
        "webRoot": "${workspaceFolder}/apps/studio",
        "preLaunchTask": "playground: dev"
      }
    ]
  }
}

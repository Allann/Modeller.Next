<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Modeller.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>modeller</ToolCommandName>
    <PackageId>Modeller.Cli</PackageId>
    <Description>Model durable domain meaning and generate deterministic outputs.</Description>
    <PackageTags>modelling;code-generation;cli;dotnet-tool</PackageTags>
    <RepositoryUrl>https://github.com/Allann/Modeller.Next</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Modeller.Parsing/Modeller.Parsing.csproj" /><ProjectReference Include="../Modeller.Generation/Modeller.Generation.csproj" /><ProjectReference Include="../Modeller.Rendering/Modeller.Rendering.csproj" /><ProjectReference Include="../Modeller.Output/Modeller.Output.csproj" /><ProjectReference Include="../Modeller.Configuration/Modeller.Configuration.csproj" /><ProjectReference Include="../Modeller.GenerationWorkflow/Modeller.GenerationWorkflow.csproj" /><ProjectReference Include="../Modeller.Templates/Modeller.Templates.csproj" /></ItemGroup>
  <ItemGroup><PackageReference Include="System.CommandLine" /></ItemGroup>
</Project>

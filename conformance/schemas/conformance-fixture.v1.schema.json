{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modeller.dev/schemas/conformance-fixture.v1.schema.json",
  "title": "Modeller conformance fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scenarioId",
    "sourceDecision",
    "capability",
    "contractVersion",
    "inputDigest",
    "input",
    "expected"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "scenarioId": { "type": "string", "minLength": 1 },
    "sourceDecision": { "type": "string", "format": "uri" },
    "capability": { "type": "string", "minLength": 1 },
    "contractVersion": { "type": "string", "minLength": 1 },
    "inputDigest": { "type": "string", "pattern": "^sha256:" },
    "input": true,
    "expected": true,
    "permittedVariance": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/(operational(/.*)?|presentation/renderedText(/.*)?)$"
      },
      "uniqueItems": true
    },
    "workBudget": { "type": "integer", "minimum": 1 },
    "maximumObservationBytes": { "type": "integer", "minimum": 1 }
  }
}

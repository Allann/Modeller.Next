{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modeller.dev/schemas/generated-failure.v1.schema.json",
  "title": "Modeller generated conformance failure",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatorVersion", "seed", "scenarioId", "minimizedFixture"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "generatorVersion": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer" },
    "scenarioId": { "type": "string", "minLength": 1 },
    "minimizedFixture": { "$ref": "conformance-fixture.v1.schema.json" }
  }
}

from ..rules.{{ definition.rule_function_name }} import {{ definition.facts_type }}

router = APIRouter(prefix="/api/behaviours", tags=["Behaviours"])


class {{ definition.name }}Request(BaseModel):
    current_stage: {{ definition.stage_type }}
    facts: {{ definition.facts_type }}


@router.post("/{{ definition.module_name }}")
def apply_endpoint(request: {{ definition.name }}Request) -> dict[str, {{ definition.stage_type }}]:

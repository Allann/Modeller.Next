from __future__ import annotations

from uuid import UUID

from ..entities.{{ definition.module_name }} import {{ definition.name }}


class InMemory{{ definition.name }}Repository:
    def __init__(self) -> None:
        self._store: dict[UUID, {{ definition.name }}] = {}

    def get(self, entity_id: UUID) -> {{ definition.name }} | None:
        return self._store.get(entity_id)

    def list(self) -> list[{{ definition.name }}]:
        return list(self._store.values())

    def add(self, entity: {{ definition.name }}) -> None:
        self._store[entity.id] = entity

    def update(self, entity: {{ definition.name }}) -> bool:
        if entity.id not in self._store:
            return False
        self._store[entity.id] = entity
        return True

    def delete(self, entity_id: UUID) -> bool:
        return self._store.pop(entity_id, None) is not None


repository = InMemory{{ definition.name }}Repository()

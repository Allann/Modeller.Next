rml 1.0
# A child-care service and its operational and organisational details.
entity Centre
  owner "Organisation"
  field Name
    type string
  end
  field Status
    type enumeration "Centre status"
  end
  field Centre code
    type string
  end
  field Approval id
    type string
    optional
  end
  field Cost centre
    type string
  end
  field Phone number
    type string
    optional
  end
  field Email address
    type string
    optional
  end
  field Website url
    type string
    optional
  end
  field Max licenced capacity
    type int32
    optional
  end
  field Iana time zone
    type string
  end
  field Australian Company Number
    type string
    optional
  end
  field Service care type
    type enumeration "Service care type"
  end
  field Latitude
    type coordinate
  end
  field Longitude
    type coordinate
  end
  relationship Addresses
    target "Centre address"
    cardinality many
  end
  relationship Service offerings
    target "Centre service offering"
    cardinality many
  end
  relationship Operating hours
    target "Centre operating hours"
    cardinality many
  end
  relationship Structure nodes
    target "Structure node"
    cardinality many
  end
  relationship Enrolments
    target "Enrolment"
    cardinality many
  end
  relationship Waitlists
    target "Waitlist"
    cardinality many
  end
end

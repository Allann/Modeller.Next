rml 1.0
# Identity and wellbeing details for a child.
entity Child
  owner "Organisation"
  field First name
    type string
  end
  field Middle name
    type string
    optional
  end
  field Last name
    type string
  end
  field Preferred name
    type string
    optional
  end
  field Former name
    type string
    optional
  end
  field Date of birth
    type date
    optional
  end
  field Date of birth is predicted
    type boolean
  end
  field CRN
    type string
    optional
  end
  field Place of birth
    type string
    optional
  end
  field Multiple births
    type boolean
  end
  field Is school aged child
    type boolean
  end
  field Show on bus list
    type boolean
  end
  field Child number
    type string
  end
  field Classroom
    type string
    optional
  end
  field School start year
    type int32
    optional
  end
  relationship Community support
    target "Child community support"
    cardinality many
    optional
  end
  relationship Support required
    target "Child specialised support required"
    cardinality many
    optional
  end
  relationship School
    target "School"
    cardinality one
    optional
  end
  relationship Consents
    target "Consent"
    cardinality many
    optional
  end
  relationship Medical record
    target "Medical record"
    cardinality one
    optional
  end
  relationship Additional needs
    target "Child additional need"
    cardinality many
    optional
  end
  relationship CCSS confirmed child
    target "CCSS confirmed child"
    cardinality one
    optional
  end
end

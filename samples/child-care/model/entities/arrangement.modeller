rml 1.0
# The care arrangement a family holds, driving which routine and casual
# sessions are booked.
entity Arrangement
  field Is casual only
    type boolean
  end
  field Start date
    type date
  end
  field End date
    type date
    optional
  end
  field Name
    type string
    optional
  end
  field Is voided
    type boolean
  end
  field Arrangement type
    type enumeration "Arrangement type"
  end
  relationship Routine booking sessions
    target "Routine booking session"
    cardinality many
  end
  relationship Casual booking sessions
    target "Casual booking session"
    cardinality many
  end
  relationship Payee
    target "Account"
    cardinality one
  end
  relationship End reason
    target "Arrangement end reason"
    cardinality one
    optional
  end
  relationship CRN holder
    target "Adult"
    cardinality one
    optional
  end
end

rml 1.0
# Core identity, authentication fields, and organisation memberships.
entity User
  field User name
    type string
  end
  field First name
    type string
  end
  field Last name
    type string
  end
  field Authentication source system
    type string
  end
  field Authentication source tenant identifier
    type string
  end
  field Authentication user identifier
    type string
  end
  relationship Organisations
    target "Organisation"
    cardinality many
    optional
  end
end

rml 1.0
# A centre address that selects its state from shared reference data.
entity Centre address
  owner "Centre"
  field Address type
    type enumeration "Address type"
  end
  field Address line 1
    type string
  end
  field Address line 2
    type string
    optional
  end
  field Suburb
    type string
  end
  relationship State
    target "State"
    cardinality one
  end
  field Postcode
    type string
  end
end

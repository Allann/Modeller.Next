rml 1.0
enumeration Booking status
  member Planned
    value 1
  end
  member Missed sign in
    value 2
  end
  member Attending
    value 3
  end
  member Missed sign out
    value 4
  end
  member Attended
    value 5
  end
  member Absence
    value 6
  end
  member Planned holiday
    value 7
  end
  member Public holiday
    value 8
  end
  member Room closure
    value 9
  end
  member Removed
    value 10
  end
  member Conflict
    value 11
  end
  member Absence void
    value 12
  end
end

{
  "appId": "com.modeller.studio",
  "productName": "Modeller Studio",
  "directories": {
    "output": "packaging/dist"
  },
  "asar": false,
  "artifactName": "ModellerStudioSetup.exe",
  "files": [
    "electron-dist/**/*",
    "server-dist/**/*",
    "server-bin/**/*",
    ".next/**/*",
    "public/**/*",
    "node_modules/**/*",
    "package.json"
  ],
  "fileAssociations": [
    {
      "ext": "modeller-workspace",
      "name": "Modeller Studio Workspace",
      "description": "Modeller Studio workspace package"
    }
  ],
  "win": {
    "target": "nsis",
    "icon": "build/icon.ico"
  },
  "nsis": {
    "perMachine": false
  }
}
